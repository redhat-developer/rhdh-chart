{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "ignorePaths": [
    "charts/**/vendor/**",
    "charts/backstage/**",
    "charts/orchestrator-software-templates/**",
    "charts/orchestrator-software-templates-infra/**"
  ],
  "baseBranchPatterns": ["main", "/^release-.*/"],
  "packageRules": [
    {
      "description": "Disable major updates on release branches",
      "matchBaseBranches": ["/^release-.*/"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "description": "EOL: disable all updates on release-1.8",
      "matchBaseBranches": ["release-1.8"],
      "enabled": false
    },
    {
      "description": "EOL: disable all updates on release-1.7",
      "matchBaseBranches": ["release-1.7"],
      "enabled": false
    },
    {
      "description": "EOL: disable all updates on release-1.6",
      "matchBaseBranches": ["release-1.6"],
      "enabled": false
    },
    {
      "description": "EOL: disable all updates on release-1.5",
      "matchBaseBranches": ["release-1.5"],
      "enabled": false
    }
  ]
}
