{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":gitSignOff",
    ":rebaseStalePrs",
    "docker:disableMajor",
    "default:pinDigestsDisabled",
    "helpers:pinGitHubActionDigests"
  ],
  "labels": [
    "kind/dependency upgrade"
  ],
  "ignorePaths": [
    "charts/**/vendor/**",
    "charts/backstage/**",
    "charts/orchestrator-software-templates/**",
    "charts/orchestrator-software-templates-infra/**"
  ],
  "baseBranchPatterns": [
    "main",
    "/^release-1\\.(9|\\d{2,}).*/",
    "/^release-([2-9]|\\d{2,})\\..*/"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "addLabels": [
      "kind/security"
    ]
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Ignore Helm-templated Docker image references that Renovate cannot resolve",
      "matchDepPatterns": ["\\{\\{"],
      "enabled": false
    },
    {
      "description": "Disable major updates on release branches",
      "matchBaseBranches": [
        "/^release-1\\.(9|\\d{2,}).*/",
        "/^release-([2-9]|\\d{2,})\\..*/"
      ],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
